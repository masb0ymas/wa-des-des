{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaDesk",
  "version": "0.2.1",
  "identifier": "app.WaDesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WaDesk",
        "width": 1180,
        "height": 820,
        "minWidth": 520,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": true,
        "titleBarStyle": "Transparent",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "capabilities": [
        "launcher",
        "session"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/masb0ymas/wa-des-des/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMzk1M0NCRUIwQjdGMTkKUldRWmZ3dnJ5MU01blE1WDI0YzhKdnFCRlZRSGQ0NlJmL3QyOVFUN3NuaU9pSGR6ZkYzY2FrcXAK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "WhatsApp Web desktop client",
    "longDescription": "Desktop shell for WhatsApp Web with multiple isolated accounts in one window, a configurable webview User-Agent, native notifications and a tray icon.",
    "copyright": "Copyright (c) 2026 WaDesk contributors",
    "publisher": "WaDesk",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
